{
  "name": "app-feedback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run tests/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check scripts tests config package.json tsconfig*.json vitest.config.ts compose.yaml docs/integration",
    "format": "prettier --write scripts tests config package.json tsconfig*.json vitest.config.ts compose.yaml docs/integration",
    "probe:switch": "node --import tsx scripts/switch-contract-probe.ts",
    "test:unit": "vitest run tests/unit",
    "demo:flow": "node --import tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "ws": "8.22.1"
  }
}
